extends Resource
class_name DirectionalSheet
## A sprite sheet with the same animations seen from 8 directions (generated by
## tools/make_directions.py). Layout: one block per animation, stacked vertically;
## each block has 8 rows (e, se, s, sw, w, nw, n, ne) and one column per frame.

@export var texture: Texture2D
## Animation names in block order. Each name must also exist in the AnimatedSprite2D's
## SpriteFrames: its speed is copied from there.
@export var anim_names: PackedStringArray = PackedStringArray()
@export var frame_counts: PackedInt32Array = PackedInt32Array()
@export var frame_size: int = 16
